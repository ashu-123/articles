🔍Let's say we want to group a stream of numbers into fixed-size chunks of 3.
-------------------------
 • Before Gatherers:

𝗟𝗶𝘀𝘁<𝗟𝗶𝘀𝘁<𝗜𝗻𝘁𝗲𝗴𝗲𝗿>> 𝗿𝗲𝘀𝘂𝗹𝘁 = 𝗻𝗲𝘄 𝗔𝗿𝗿𝗮𝘆𝗟𝗶𝘀𝘁<>();
𝗟𝗶𝘀𝘁<𝗜𝗻𝘁𝗲𝗴𝗲𝗿> 𝘁𝗲𝗺𝗽 = 𝗻𝗲𝘄 𝗔𝗿𝗿𝗮𝘆𝗟𝗶𝘀𝘁<>();

𝗳𝗼𝗿 (𝗶𝗻𝘁 𝗶 = 𝟭; 𝗶 <= 𝟭𝟬; 𝗶++) {
 𝘁𝗲𝗺𝗽.𝗮𝗱𝗱(𝗶);
 𝗶𝗳 (𝘁𝗲𝗺𝗽.𝘀𝗶𝘇𝗲() == 𝟯) {
 𝗿𝗲𝘀𝘂𝗹𝘁.𝗮𝗱𝗱(𝗻𝗲𝘄 𝗔𝗿𝗿𝗮𝘆𝗟𝗶𝘀𝘁<>(𝘁𝗲𝗺𝗽));
 𝘁𝗲𝗺𝗽.𝗰𝗹𝗲𝗮𝗿();
 }
}
𝗶𝗳 (!𝘁𝗲𝗺𝗽.𝗶𝘀𝗘𝗺𝗽𝘁𝘆()) 𝗿𝗲𝘀𝘂𝗹𝘁.𝗮𝗱𝗱(𝘁𝗲𝗺𝗽);

𝗦𝘆𝘀𝘁𝗲𝗺.𝗼𝘂𝘁.𝗽𝗿𝗶𝗻𝘁𝗹𝗻(𝗿𝗲𝘀𝘂𝗹𝘁); 

